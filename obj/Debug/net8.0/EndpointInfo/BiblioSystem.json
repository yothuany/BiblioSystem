  "components": {
    "schemas": {
      "AutorDto": {
        "required": [
          "biografia",
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "minLength": 3,
            "type": "string"
          },
          "biografia": {
            "minLength": 10,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CategoriaDto": {
        "required": [
          "descricao",
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "minLength": 3,
            "type": "string"
          },
          "descricao": {
            "minLength": 5,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "EmprestimoDto": {
        "required": [
          "dataPrevistaDevolucao",
          "exemplarId",
          "membroId"
        ],
        "type": "object",
        "properties": {
          "membroId": {
            "type": "integer",
            "format": "int32"
          },
          "exemplarId": {
            "type": "integer",
            "format": "int32"
          },
          "dataPrevistaDevolucao": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "ExemplarDto": {
        "required": [
          "codigoExemplar",
          "livroId"
        ],
        "type": "object",
        "properties": {
          "codigoExemplar": {
            "minLength": 1,
            "type": "string"
          },
          "livroId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LivroDto": {
        "required": [
          "anoPublicacao",
          "categoriaId",
          "editora",
          "isbn",
          "titulo"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "minLength": 1,
            "type": "string"
          },
          "isbn": {
            "minLength": 1,
            "type": "string"
          },
          "anoPublicacao": {
            "type": "integer",
            "format": "int32"
          },
          "editora": {
            "minLength": 1,
            "type": "string"
          },
          "categoriaId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MembroDto": {
        "required": [
          "cpf",
          "email",
          "nomeCompleto",
          "telefone"
        ],
        "type": "object",
        "properties": {
          "nomeCompleto": {
            "minLength": 1,
            "type": "string"
          },
          "cpf": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "telefone": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ReservaDto": {
        "required": [
          "livroId",
          "membroId"
        ],
        "type": "object",
        "properties": {
          "membroId": {
            "type": "integer",
            "format": "int32"
          },
          "livroId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UsuarioDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Bearer {token}",
        "name": "Authorization",
        "in": "header"
      }
